{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "types": [
            "svelte",
            "vite/client",
            "node"
        ]
    },
    "include": [
        "tests/js/**/*.ts",
        "tests/js/**/*.mjs",
        "resources/js/**/*.ts",
        "resources/js/**/*.js",
        "resources/js/**/*.svelte"
    ],
    "exclude": [
        "node_modules",
        "vendor"
    ]
}

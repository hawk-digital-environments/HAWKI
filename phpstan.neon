includes:
    - vendor/larastan/larastan/extension.neon

services:
    -
        class: App\Services\PhpStan\RepositoryReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: App\Services\PhpStan\CastableObjectPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension
    -
        class: App\Services\PhpStan\DecoratorTraitPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension

parameters:
    paths:
        - app/
    excludePaths:
        - app/Console/Commands/Dev/DbgCommand.php (?)
    ignoreErrors:
        - identifier: function.alreadyNarrowedType
        # Kept alive by historical migrations in database/migrations, which are
        # outside the analysed paths, so PHPStan cannot see its usages.
        -
            identifier: trait.unused
            path: app/Services/Ai/ConfigFileSync/ConfigSyncMigrationTrait.php
    level: 5
    stubFiles:
        - phpstan.php.stub
